  @{ Old = "@/components/admin/RecentTransactionsTable"; New = "@/components/admin/dashboard/RecentTransactionsTable" }
  @{ Old = "@/components/customer/RecommendedProducts"; New = "@/components/customer/product-details/RecommendedProducts" }
