  @{ Old = "@/store/orderStore"; New = "@/store/customer/orderStore" }
  @{ Old = "@/store/cartStore"; New = "@/store/customer/cartStore" }
  @{ Old = "@/lib/adminUsers"; New = "@/lib/admin/users" }
  @{ Old = "@/lib/checkout"; New = "@/lib/customer/checkout" }
  @{ Old = "@/lib/products"; New = "@/lib/customer/products" }
  @{ Old = "@/lib/profile"; New = "@/lib/customer/profile" }
  @{ Old = "@/lib/payouts"; New = "@/lib/seller/payouts" }
  @{ Old = "@/lib/orders"; New = "@/lib/customer/orders" }
  @{ Old = "@/lib/cart"; New = "@/lib/customer/cart" }
)

$files = Get-ChildItem -Path "app","components","lib","store","constants" -Recurse -Include *.js,*.jsx -File
foreach ($file in $files) {
    $content = Get-Content -Path $file.FullName -Raw
    $original = $content
    foreach ($pair in $pairs) {
        $content = $content -replace [regex]::Escape('"' + $pair.Old + '"'), ('"' + $pair.New + '"')
    }
    if ($content -ne $original) {
        Set-Content -Path $file.FullName -Value $content -NoNewline
        Write-Host "Updated:" $file.FullName
    }
}

Write-Host "Done. Now run: Remove-Item -Recurse -Force .next ; npm run dev"